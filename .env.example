# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://ufupcmahtmukwxvzjllj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server only - never expose to the client (Settings → API → service_role).
# Required for admin CMS writes and for saving public /contact inquiries.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Single admin (must match Supabase Auth user email after magic link)
ADMIN_EMAIL=dev.leafo@gmail.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production: set to your live origin (no trailing slash), e.g. https://leafo.in
# Optional: force indexing on/off (defaults: off on localhost, on in production)
# NEXT_PUBLIC_ALLOW_INDEXING=true

# Google Search Console HTML tag verification (Search Console → Settings → Ownership verification)
# GOOGLE_SITE_VERIFICATION=your_verification_token
