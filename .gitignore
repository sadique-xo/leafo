# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# large local assets (scroll sequence frames; app uses planters.jpg)
/public/frames/

# raw product photography master files; web copies are built into public/products/
/for-co-work/

# local dev/debug screenshots (keep out of repo root)
/docs/dev-screenshots/
/*-check*.png
/*-layout*.png

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env - secrets & local overrides; commit .env.example as the template
.env*
!.env.example

# vercel
.vercel

# local tool / IDE (Cursor workspaces, MCP bins, editor settings)
.cursor/

# typescript
*.tsbuildinfo
next-env.d.ts
.playwright-mcp/